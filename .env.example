# ============================================================
#  BiziToys bot — sozlamalar namunasi
#  Bu faylni ".env" nomi bilan nusxalang va qiymatlarni to'ldiring.
#  ⚠️ .env faylini HECH QACHON GitHub'ga yuklamang!
# ============================================================

# ---------- Telegram ----------
# @BotFather dan olinadi
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Adminlar Telegram ID'lari (vergul bilan). Botga /id yozib bilib olasiz.
ADMIN_IDS=123456789

# Ishchi guruh chat ID (manfiy son, masalan -1001234567890). Bo'sh qoldirsa bo'ladi.
GROUP_CHAT_ID=

# ---------- Ish rejimi ----------
# true  = API kalitlarsiz, soxta ma'lumot bilan test qilish
# false = real Uzum va Billz API bilan ishlash
MOCK_MODE=true

# ---------- Uzum Seller API ----------
UZUM_BASE_URL=https://api-seller.uzum.uz
UZUM_TOKEN=

# Do'kon ID'lari, vergul bilan. Bo'sh qoldirsangiz — hammasi avtomatik olinadi.
# Sizniki: 77165, 77419, 79873, 97583, 123074
UZUM_SHOP_IDS=

# ---------- KO'P DO'KON EGASI (ixtiyoriy) ----------
# Bir nechta egasi bo'lsa — har biri O'Z tokeni va do'konlari bilan.
# Format:  Nomi|Token|Do'konID,Do'konID ; Nomi2|Token2|Do'konID,...
#
# OSON USUL (tavsiya): UZUM_ACCOUNTS ga faqat YANGI egasini yozing —
# eski UZUM_TOKEN avtomatik qo'shib olinadi, hech narsa buzilmaydi:
#
#   UZUM_ACCOUNT_NAME=Abduqahhor     ← eski tokeningizning nomi
#   UZUM_ACCOUNTS=Kamoliddin|TOKEN2| ← yangi egasi (do'konlari bo'sh = o'zi topadi)
#
# Yoki hammasini bitta qatorda:
#   UZUM_ACCOUNTS=Abduqahhor|TOKEN1|77165,77419 ; Kamoliddin|TOKEN2|11111,22222
#
# Botda ishlaganda egasini tanlash tugmalari chiqadi; hisobotlar har
# egasiga ALOHIDA hisoblanadi va yuboriladi. Bo'sh qoldirilsa —
# yuqoridagi UZUM_TOKEN bitta egasi sifatida ishlayveradi.
UZUM_ACCOUNTS=

# Xodimni egasiga biriktirish: admin botda /egasi 123456789 Abduqahhor

# ---------- Sun'iy intellekt (ixtiyoriy) ----------
# console.anthropic.com dan olinadi. Bo'sh qoldirsangiz bot AI'siz ishlaydi.
# Qaysi provayder: anthropic (to'g'ridan-to'g'ri) yoki make (Make.com orqali)
AI_PROVIDER=anthropic

# anthropic uchun — console.anthropic.com dan olinadi
AI_KEY=
AI_MODEL=claude-haiku-4-5-20251001

# make uchun — Make.com stsenariysining webhook manzili
MAKE_AI_WEBHOOK=

# ---------- Billz API ----------
BILLZ_BASE_URL=https://api-admin.billz.uz/v1
BILLZ_SECRET_TOKEN=

# ---------- Vaqt va hisobotlar ----------
TIMEZONE=Asia/Tashkent
MORNING_REPORT_AT=09:30
EVENING_REPORT_AT=18:30
STOCK_CHECK_AT=10:00
SKLAD_LIST_AT=11:00
MONEY_REPORT_AT=08:00     # kunlik moliyaviy hisobot (adminlarga, kechagi kun)

# Afzal ko'riladigan qabul punktlari (tuman/ko'cha nomi, vergul bilan)
PVZ_PREFERRED=Uchtepa,Chilonzor,Eshonguzar,Sergeli
LATE_CHECK_EVERY_MIN=60

# Bot o'zi yozib turishi uchun
NEW_ORDER_CHECK_MIN=5      # yangi buyurtmani necha daqiqada tekshirish
NUDGE_EVERY_MIN=90         # "hali ish bor" eslatmasi oralig'i
WORK_FROM=9                # ish boshlanishi (tunda bezovta qilmasin)
WORK_TO=20                 # ish tugashi

# ---------- Biznes qoidalari ----------
# Uzum muddatiga necha soat qolganda ogohlantirish yuborilsin
WARN_BEFORE_HOURS=6
LATE_AFTER_HOURS=4
DEFAULT_MIN_STOCK=5

# ---------- Baza ----------
DB_PATH=data/bot.db
